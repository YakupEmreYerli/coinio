{
  "name": "coinio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:server": "tsup src/server/index.ts --format esm --out-dir dist/server --clean --onSuccess \"node scripts/copy-migrations.mjs\"",
    "build:web": "vite build",
    "build:site": "node site-src/build.mjs",
    "build:demo": "tsx scripts/demo-assets.ts dist/demo-public && vite build -c vite.demo.config.ts",
    "build": "pnpm build:server && pnpm build:web",
    "start": "node dist/server/index.js",
    "dev": "concurrently -k -n api,web -c gray,gray \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "PORT=4661 COINIO_DATA_DIR=./.data COINIO_PUBLIC_URL=http://localhost:4660 tsx watch src/server/index.ts",
    "dev:web": "vite"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@node-rs/argon2": "^2.2.2",
    "better-sqlite3": "^13.2.0",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "multer": "^2.5.0",
    "nodemailer": "^10.1.4",
    "simple-icons": "^16.38.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@hookform/resolvers": "^7.0.7",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.108.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.3.0",
    "cmdk": "^1.1.1",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^31.0.1",
    "lucide-react": "^1.75.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.11.0",
    "sonner": "^2.0.8",
    "supertest": "^7.3.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
